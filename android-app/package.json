{
  "name": "xiohu-little-universe-android",
  "version": "1.0.0",
  "private": true,
  "description": "Android app for our little universe",
  "scripts": {
    "copy:web": "node scripts/sync-web.mjs",
    "android:add": "cap add android",
    "native:bundle": "esbuild scripts/native-runtime.mjs --bundle --format=iife --outfile=www/js/native-runtime.js",
    "android:sync": "npm run copy:web && npm run native:bundle && cap sync android",
    "android:open": "npm run android:sync && cap open android",
    "android:build:debug": "node scripts/build-android.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/app": "^7.1.0",
    "@capacitor/core": "^7.4.4",
    "@capacitor/splash-screen": "^7.0.3",
    "@capacitor/status-bar": "^7.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
    "esbuild": "^0.25.0"
  }
}
